package com.mycompany.mavenproject3;
import java.util.Scanner;
 
public class Mavenproject3 {
 
    // V = (1/3) * pi * r^2 * h, where r = diameter / 2
    public static double coneVolume(double dValue, double hValue) {
        double r = dValue / 2;
        // 1.0 / 3 (not 1 / 3): with two ints, 1 / 3 evaluates to 0 in Java
        return (1.0 / 3) * Math.PI * r * r * hValue;
    }
 
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);
        System.out.print("Enter diameter: ");
        double d = s.nextDouble();
        System.out.print("Enter height: ");
        double h = s.nextDouble();
        System.out.printf("Volume: %.2f%n", coneVolume(d, h));
        s.close();
    }
}